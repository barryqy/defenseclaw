new file mode 100644
index 0000000000000000000000000000000000000000..5806b71d7a2654f4ae2dc2f3fea776d3b797785d
--- /dev/null
+++ b/src/windows-private-acl.ts
@@ -0,0 +1,121 @@
+import { spawn } from "node:child_process";
+import path from "node:path";
+import { trustedWindowsPowershell } from "./trusted-windows-command.js";
+import { windowsSystemEnvironment } from "./windows-system.js";
+
+const aclTimeoutMs = 120_000;
+const privateAclScript = String.raw`
+$ErrorActionPreference = "Stop"
+if ($args.Count -ne 2) { throw "invalid ACL request" }
+$operation = $args[0]
+$target = [IO.Path]::GetFullPath($args[1])
+$item = Get-Item -LiteralPath $target -Force -ErrorAction Stop
+if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw "reparse point" }
+$currentSid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User
+$systemSid = [System.Security.Principal.SecurityIdentifier]::new("S-1-5-18")
+$wantedSids = @($currentSid.Value, $systemSid.Value) | Select-Object -Unique
+$isDirectory = [bool]$item.PSIsContainer
+if ($operation -eq "apply") {
+    if ($isDirectory) {
+        $acl = [System.Security.AccessControl.DirectorySecurity]::new()
+        $inheritance = ([System.Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [System.Security.AccessControl.InheritanceFlags]::ObjectInherit)
+    } else {
+        $acl = [System.Security.AccessControl.FileSecurity]::new()
+        $inheritance = [System.Security.AccessControl.InheritanceFlags]::None
+    }
+    $acl.SetOwner($currentSid)
+    $acl.SetAccessRuleProtection($true, $false)
+    foreach ($sid in @($currentSid, $systemSid)) {
+        $rule = [System.Security.AccessControl.FileSystemAccessRule]::new(
+            $sid,
+            [System.Security.AccessControl.FileSystemRights]::FullControl,
+            $inheritance,
+            [System.Security.AccessControl.PropagationFlags]::None,
+            [System.Security.AccessControl.AccessControlType]::Allow
+        )
+        [void]$acl.AddAccessRule($rule)
+    }
+    Set-Acl -LiteralPath $item.FullName -AclObject $acl -ErrorAction Stop
+} elseif ($operation -ne "verify") {
+    throw "invalid ACL operation"
+}
+$observed = Get-Acl -LiteralPath $item.FullName -ErrorAction Stop
+if (-not $observed.AreAccessRulesProtected) { throw "inherited ACL" }
+if ($observed.GetOwner([System.Security.Principal.SecurityIdentifier]).Value -ne $currentSid.Value) {
+    throw "owner mismatch"
+}
+$rules = @($observed.GetAccessRules($true, $false, [System.Security.Principal.SecurityIdentifier]))
+if ($rules.Count -ne $wantedSids.Count) { throw "unexpected ACL rules" }
+$seen = @{}
+foreach ($rule in $rules) {
+    $sid = $rule.IdentityReference.Value
+    if ($wantedSids -notcontains $sid -or $seen.ContainsKey($sid)) { throw "unexpected ACL identity" }
+    $seen[$sid] = $true
+    if ($rule.AccessControlType -ne [System.Security.AccessControl.AccessControlType]::Allow) {
+        throw "deny ACL"
+    }
+    if (($rule.FileSystemRights -band [System.Security.AccessControl.FileSystemRights]::FullControl) -ne [System.Security.AccessControl.FileSystemRights]::FullControl) {
+        throw "insufficient ACL"
+    }
+    $expectedInheritance = if ($isDirectory) {
+        ([System.Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [System.Security.AccessControl.InheritanceFlags]::ObjectInherit)
+    } else {
+        [System.Security.AccessControl.InheritanceFlags]::None
+    }
+    if ($rule.InheritanceFlags -ne $expectedInheritance -or
+        $rule.PropagationFlags -ne [System.Security.AccessControl.PropagationFlags]::None) {
+        throw "unexpected ACL inheritance"
+    }
+}
+`;
+
+export async function applyPrivateWindowsAcl(target: string): Promise<void> {
+  if (process.platform !== "win32") return;
+  await runAcl("apply", target);
+}
+
+export async function verifyPrivateWindowsAcl(target: string): Promise<void> {
+  if (process.platform !== "win32") return;
+  await runAcl("verify", target);
+}
+
+async function runAcl(operation: "apply" | "verify", target: string): Promise<void> {
+  const powershell = trustedWindowsPowershell();
+  await new Promise<void>((resolve, reject) => {
+    const child = spawn(powershell, [
+      "-NoLogo",
+      "-NoProfile",
+      "-NonInteractive",
+      "-ExecutionPolicy",
+      "Bypass",
+      "-Command",
+      privateAclScript,
+      operation,
+      path.resolve(target)
+    ], {
+      cwd: path.dirname(powershell),
+      env: windowsSystemEnvironment(),
+      shell: false,
+      stdio: "ignore",
+      windowsHide: true
+    });
+    let timedOut = false;
+    const timer = setTimeout(() => {
+      timedOut = true;
+      child.kill();
+    }, aclTimeoutMs);
+    timer.unref();
+    child.once("error", (error) => {
+      clearTimeout(timer);
+      reject(error);
+    });
+    child.once("close", (code) => {
+      clearTimeout(timer);
+      if (timedOut || code !== 0) {
+        reject(new Error("Managed s-gw data does not have a private Windows ACL."));
+        return;
+      }
+      resolve();
+    });
+  });
+}
