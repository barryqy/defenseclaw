+import { execFileSync, spawnSync } from "node:child_process";
+import { access, chmod, mkdtemp, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { describe, expect, it } from "vitest";
+
+const repoRoot = process.cwd();
+const tsxBin = path.join(repoRoot, "node_modules", ".bin", process.platform === "win32" ? "tsx.cmd" : "tsx");
+
+describe("DefenseClaw local console launch", () => {
+  it("admits only the host-resolved PowerShell path on Windows", async () => {
+    const sources = await Promise.all([
+      "install.ts",
+      "unlock.ts",
+      "windows-private-acl.ts"
+    ].map((name) => readFile(new URL(`../src/${name}`, import.meta.url), "utf8")));
+    const trusted = await readFile(new URL("../src/trusted-windows-command.ts", import.meta.url), "utf8");
+
+    expect(sources.join("\n")).not.toContain('"powershell.exe"');
+    expect(sources.join("\n")).not.toContain("process.env.SystemRoot");
+    expect(trusted).toContain("process.env.SGW_TRUSTED_POWERSHELL");
+    expect(trusted).toContain("realpathSync(candidate)");
+  });
+
+  it("contains no TypeScript proxy-tokenizer or approval mutation fallback", async () => {
+    const cli = await readFile(new URL("../src/cli.ts", import.meta.url), "utf8");
+    const mcp = await readFile(new URL("../src/mcp-server.ts", import.meta.url), "utf8");
+    const sourceNames = (await readdir(new URL("../src/", import.meta.url))).filter((name) => name.endsWith(".ts"));
+    const sourceText = await Promise.all(
+      sourceNames.map((name) => readFile(new URL(`../src/${name}`, import.meta.url), "utf8"))
+    );
+    const tsconfig = await readFile(new URL("../tsconfig.json", import.meta.url), "utf8");
+
+    await expect(readFile(new URL("../src/tokenizer.ts", import.meta.url), "utf8")).rejects.toThrow();
+    await expect(readFile(new URL("../src/console-launch.ts", import.meta.url), "utf8")).rejects.toThrow();
+    expect(`${cli}\n${mcp}`).not.toContain("approvePendingEnrollment");
+    expect(`${cli}\n${mcp}`).not.toContain("denyPendingEnrollment");
+    expect(`${cli}\n${mcp}`).not.toContain("sgw_prepare_proxy_tokenization");
+    expect(`${cli}\n${mcp}`).not.toContain("defenseclaw-tokenizer");
+    expect(cli).not.toContain("startConsoleServer");
+    expect(cli).not.toContain("function openBrowser");
+    expect(cli).toContain("DefenseClaw owns the authenticated approval console");
+    expect(cli.indexOf("rejectDefenseClawAuthorizationMutation(first, second, third)")).toBeLessThan(
+      cli.indexOf("const store = new SecretStore()")
+    );
+    expect(cli).not.toContain("  s-gw approve REQUEST_ID");
+    expect(cli).not.toContain("  s-gw deny REQUEST_ID");
+    expect(cli).not.toContain("  s-gw secret allow-command HANDLE");
+    expect(cli).not.toContain("  s-gw secret set-inject-env HANDLE");
+    expect(cli).not.toContain("  s-gw approval policy add");
+    expect(cli).not.toContain("  s-gw unlock keychain set");
+    expect(sourceText.join("\n")).not.toContain("s-gw approve");
+    expect(tsconfig).toContain('"src/console-server.ts"');
+  });
+
+  it("rejects approval and authorization mutations before creating store state", async () => {
+    const policyAliases = ["add", "update", "edit", "arrange", "organize", "delete", "remove", "enable", "disable"];
+    const rejectedRoutes = [
+      ["approve", "req-test"],
+      ["deny", "req-test"],
+      ["approval", "set"],
+      ["approval", "revoke"],
+      ["approval", "clear"],
+      ["unlock", "keychain", "set"],
+      ["unlock", "keychain", "delete"],
+      ["unlock", "keychain", "repair"],
+      ["secret", "allow-command"],
+      ["secret", "set-inject-env"],
+      ...policyAliases.flatMap((action) => [
+        ["approval", "policy", action],
+        ["approval", "policies", action]
+      ])
+    ];
+
+    for (const [index, route] of rejectedRoutes.entries()) {
+      const tmpDir = await mkdtemp(path.join(os.tmpdir(), `sgw-native-auth-${index}-`));
+      const home = path.join(tmpDir, "home");
+      const recoveryHome = path.join(tmpDir, "recovery");
+
+      try {
+        const result = spawnSync(tsxBin, [path.join(repoRoot, "src", "cli.ts"), ...route], {
+          cwd: repoRoot,
+          encoding: "utf8",
+          env: {
+            ...process.env,
+            SGW_DISABLE_KEYCHAIN: "1",
+            SGW_DISABLE_ONEPASSWORD_BACKUP: "1",
+            SGW_DISABLE_UPDATE_CHECK: "1",
+            SGW_HOME: home,
+            SGW_RECOVERY_HOME: recoveryHome,
+            SGW_TEST_HOME_ROOT: tmpDir,
+            SGW_TEST_MODE: "1"
+          },
+          timeout: 10_000
+        });
+
+        expect(result.status, route.join(" ")).not.toBe(0);
+        expect(result.stderr, route.join(" ")).toContain("DefenseClaw owns authenticated approval and authorization changes");
+        await expect(access(home), route.join(" ")).rejects.toThrow();
+        await expect(access(recoveryHome), route.join(" ")).rejects.toThrow();
+      } finally {
+        await rm(tmpDir, { recursive: true, force: true });
+      }
+    }
+  }, 45_000);
+
+  it("stores a generated Linux unlock key through the Secret Service helper", async () => {
+    const tmpDir = await mkdtemp(path.join(os.tmpdir(), "sgw-linux-setup-"));
+    const helperPath = path.join(tmpDir, "s-gw-secret-service-helper");
+    const database = path.join(tmpDir, "credential");
+    const wrapper = path.join(tmpDir, "linux-setup.mts");
+    const cliPath = path.join(repoRoot, "src", "cli.ts");
+    const helper = `#!${process.execPath}\n`
+      + `const fs = require("node:fs");\n`
+      + `const command = process.argv[2];\n`
+      + `const database = process.env.SGW_FAKE_SECRET_SERVICE_DB;\n`
+      + `if (command === "status") { console.log(JSON.stringify({ configured: fs.existsSync(database) })); process.exit(0); }\n`
+      + `if (command === "set") { fs.writeFileSync(database, fs.readFileSync(0), { mode: 0o600 }); process.exit(0); }\n`
+      + `if (command === "get") { process.stdout.write(fs.readFileSync(database)); process.exit(0); }\n`
+      + `if (command === "delete") { fs.rmSync(database, { force: true }); process.exit(0); }\n`
+      + `process.exit(2);\n`;
+    const wrapperSource = `Object.defineProperty(process, "platform", { value: "linux" });\n`
+      + `process.argv = [process.execPath, ${JSON.stringify(cliPath)}, "setup", "--no-open-console", "--no-service", "--no-menubar", "--no-agents"];\n`
+      + `await import(${JSON.stringify(pathToFileURL(cliPath).href)});\n`;
+
+    try {
+      await writeFile(helperPath, helper, { mode: 0o700 });
+      await chmod(helperPath, 0o700);
+      await writeFile(wrapper, wrapperSource);
+      const output = execFileSync(tsxBin, [wrapper], {
+        cwd: repoRoot,
+        encoding: "utf8",
+        env: {
+          ...process.env,
+          SGW_DISABLE_KEYCHAIN: "0",
+          SGW_DISABLE_ONEPASSWORD_BACKUP: "1",
+          SGW_FAKE_SECRET_SERVICE_DB: database,
+          SGW_HOME: path.join(tmpDir, "home"),
+          SGW_RECOVERY_HOME: path.join(tmpDir, "recovery"),
+          SGW_SECRET_SERVICE_HELPER: helperPath,
+          SGW_TEST_HOME_ROOT: tmpDir,
+          SGW_TEST_MODE: "1"
+        },
+        stdio: ["ignore", "pipe", "pipe"]
+      });
+      const setup = JSON.parse(output) as {
+        nextSteps: string[];
+        ok: boolean;
+        unlock: string;
+      };
+      const stored = await readFile(database, "utf8");
+
+      expect(setup).toMatchObject({ ok: true, unlock: "generated-keychain-passphrase" });
+      expect(setup.nextSteps[0]).toBe("Open the approval console with `defenseclaw credential-protection open`.");
+      expect(stored.trim().length).toBeGreaterThanOrEqual(8);
+      expect(output).not.toContain(stored);
+    } finally {
+      await rm(tmpDir, { recursive: true, force: true });
+    }
+  }, 15_000);
+});
