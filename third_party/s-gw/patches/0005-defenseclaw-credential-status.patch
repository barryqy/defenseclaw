From 68b5807224d3a048cdc61519acb80a0b2e037387 Mon Sep 17 00:00:00 2001
From: barry <bayuan@cisco.com>
Date: Tue, 4 Aug 2026 21:19:43 -0700
Subject: [PATCH 5/7] Fail closed on credential helper status

---
 src/unlock.ts                     | 5 ++++-
 tests/defenseclaw-runtime.test.ts | 7 ++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/unlock.ts b/src/unlock.ts
index 03a872646b845791571a3ed3a5046484f6416278..fbf871b92ced3287c81c3235fe813fdd003ab2dd 100644
--- a/src/unlock.ts
+++ b/src/unlock.ts
@@ -1044,7 +1044,10 @@ function keychainItemExists(info: KeychainInfo): boolean {
       ["status", "--service", info.service, "--account", info.account]
     );
     const status = JSON.parse(output) as { configured?: unknown };
-    return status.configured === true;
+    if (typeof status.configured !== "boolean") {
+      throw new Error("Linux Secret Service helper status returned an invalid response.");
+    }
+    return status.configured;
   }
 
   return false;
diff --git a/tests/defenseclaw-runtime.test.ts b/tests/defenseclaw-runtime.test.ts
index b8ea5fd9a6d7eac3b6fd94d6fa55afb79e2b021c..24a415752e01ca426939bf3f5d54342fd4b8fc2d 100644
--- a/tests/defenseclaw-runtime.test.ts
+++ b/tests/defenseclaw-runtime.test.ts
@@ -9,18 +9,22 @@ const repoRoot = process.cwd();
 const tsxCli = path.join(repoRoot, "node_modules", "tsx", "dist", "cli.mjs");
 
 describe("DefenseClaw local console launch", () => {
-  it("admits only the host-resolved PowerShell path on Windows", async () => {
+  it("admits only trusted PowerShell paths on Windows", async () => {
     const sources = await Promise.all([
       "install.ts",
       "unlock.ts",
       "windows-private-acl.ts"
     ].map((name) => readFile(new URL(`../src/${name}`, import.meta.url), "utf8")));
     const trusted = await readFile(new URL("../src/trusted-windows-command.ts", import.meta.url), "utf8");
+    const sshAcl = await readFile(new URL("../src/windows-acl.ts", import.meta.url), "utf8");
 
     expect(sources.join("\n")).not.toContain('"powershell.exe"');
     expect(sources.join("\n")).not.toContain("process.env.SystemRoot");
     expect(trusted).toContain("process.env.SGW_TRUSTED_POWERSHELL");
     expect(trusted).toContain("realpathSync(candidate)");
+    expect(sshAcl).toContain("GLOBALROOT\\SystemRoot");
+    expect(sshAcl).toContain('process.env.SGW_TEST_MODE !== "1"');
+    expect(sshAcl).not.toContain('spawn("powershell.exe"');
   });
 
   it("hides every synchronous PowerShell window", async () => {
@@ -91,6 +95,7 @@ describe("DefenseClaw local console launch", () => {
       expect(setupHandler).not.toContain(forbidden);
     }
     expect(sourceText.join("\n")).not.toContain("s-gw approve");
+    expect(sourceText.join("\n")).toContain("Linux Secret Service helper status returned an invalid response.");
     expect(tsconfig).toContain('"src/console-server.ts"');
   });
 
